# Frontend host port exposed by docker compose
FRONTEND_PORT=3000

# Browser-visible frontend origin used by backend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Browser-visible backend API URL compiled into the frontend build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional backend override for screener artifact storage
SCREENER_RESULTS_DIR=./results/screener

# Backend-only manifest path used by web-triggered US screener runs
SCREEN_US_MANIFEST_PATH=

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XIAOHUMINI_API_KEY=

# Market data
TUSHARE_TOKEN=
