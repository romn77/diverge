# -----------------------------------------------------------------------------
# Local web entrypoints and public URLs
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-visible frontend origin used by backend CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Browser-visible backend API URL compiled into the frontend build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production nginx host/ports used by compose.prod.yml.
PUBLIC_HOSTNAME=example.com
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=diverge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth and session
# -----------------------------------------------------------------------------
# AUTH_MODE:
#   disabled -> auth codepaths stay off even if AUTH_ENABLED=true
#   optional -> auth/session is live, but compatibility routes stay readable during rollout
#   required -> protected routes require login
AUTH_ENABLED=true
AUTH_MODE=required
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
SESSION_COOKIE_NAME=diverge_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Comma-separated CIDRs allowed to supply X-Forwarded-For to the backend.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# -----------------------------------------------------------------------------
# On-disk data layout
# -----------------------------------------------------------------------------
# Set one root; reports, screeners, cache, history, fundamentals, and manifests
# are derived from it. Non-standard override variables are documented in web/README.md.
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Screener manifests, ARQ prewarm, and OHLCV readiness gates
# -----------------------------------------------------------------------------
# Standard manifest layout is DATA_DIR/manifest/{cn,us}.csv.
# CN screening falls back to the configured source chain when no CN manifest exists.
# US screening requires DATA_DIR/manifest/us.csv.

# ARQ prewarm services tick lightly inside vendor-ready windows.
PREWARM_CN_READY_TIME=18:10
PREWARM_CN_WINDOW_END=21:30
PREWARM_US_READY_TIME=21:10
PREWARM_US_WINDOW_END=23:30
PREWARM_RETRY_DEFER_SECONDS=300
PREWARM_MAX_TRIES=5

# Same-day OHLCV sync readiness gates. Values are vendor-local HH:MM.
DATA_SYNC_TUSHARE_READY_TIME=18:10
DATA_SYNC_MASSIVE_READY_TIME=21:10

# -----------------------------------------------------------------------------
# Task queue and local Redis helper
# -----------------------------------------------------------------------------
# TASK_BACKEND:
#   local -> development in-process task threads
#   redis -> production API/worker split using REDIS_URL and multi-layer scheduling
TASK_BACKEND=local
TASK_GLOBAL_RUNNING_LIMIT=2
TASK_USER_RUNNING_LIMIT=1
TASK_GLOBAL_PENDING_LIMIT=100
TASK_USER_PENDING_LIMIT_ADMIN=10
TASK_USER_PENDING_LIMIT_OPERATOR=5
TASK_USER_PENDING_LIMIT_VIEWER=2
TASK_STORE_TERMINAL_TTL_SECONDS=604800

# Worker/backend task logs use structured task_event lines. Set LOG_LEVEL=debug
# for lower-level Python logs; task lifecycle monitoring is emitted at INFO.
LOG_LEVEL=info
# Optional stable worker label for operations; defaults to hostname:pid.
WORKER_ID=

# Deprecated compatibility fallback for TASK_GLOBAL_RUNNING_LIMIT.
TASK_QUEUE_LIMIT=2

REDIS_URL=redis://redis:6379/0
# For web/start.sh local Redis testing, use REDIS_URL=redis://127.0.0.1:6379/0.
# Set START_REDIS_DOCKER=true to let web/start.sh start a named Redis container.
START_REDIS_DOCKER=false
REDIS_CONTAINER_NAME=diverge-redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Object storage and data-source governance
# -----------------------------------------------------------------------------
# STORAGE_BACKEND:
#   local -> development filesystem
#   tencent_cos -> production Tencent Cloud COS
#   s3_compatible -> reserved for a future overseas R2/S3 adapter
STORAGE_BACKEND=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PREFIX=diverge/prod

# Keep false in production so data-source admin policies fail closed if
# database-backed governance is unavailable.
DATA_SOURCE_USAGE_ALLOW_LOCAL_FALLBACK=false
# Optional: force production-style fail-closed governance outside APP_ENV=production.
DATA_SOURCE_GOVERNANCE_STRICT=false

# -----------------------------------------------------------------------------
# Production backups
# -----------------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400

# -----------------------------------------------------------------------------
# LLM provider credentials
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Gemini native API alias used by Gemini CLI and Gemini-compatible gateways.
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
XIAOHUMINI_API_KEY=
SUB2API_API_KEY=
MIMO_API_KEY=

# -----------------------------------------------------------------------------
# Market data provider credentials
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=
MASSIVE_BASE_URL=http://bcprivateserver.site/api/v1
SIMFIN_API_KEY=
TUSHARE_TOKEN=
