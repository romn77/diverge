# Frontend host port exposed by docker compose
FRONTEND_PORT=3000

# Browser-visible frontend origin used by backend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Browser-visible backend API URL compiled into the frontend build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XIAOHUMINI_API_KEY=
