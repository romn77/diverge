# Frontend host port exposed by docker compose
FRONTEND_PORT=3000
PUBLIC_HOSTNAME=example.com
HTTP_PORT=80
HTTPS_PORT=443

# Browser-visible frontend origin used by backend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Browser-visible backend API URL compiled into the frontend build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth/session foundation
# Docker compose requires POSTGRES_PASSWORD, DATABASE_URL, and bootstrap admin values.
POSTGRES_PASSWORD=
# AUTH_MODE:
#   disabled -> auth codepaths stay off even if AUTH_ENABLED=true
#   optional -> auth/session is live, but existing routes stay readable while you backfill metadata
#   required -> protected routes require login
AUTH_ENABLED=true
AUTH_MODE=required
DATABASE_URL=
SESSION_COOKIE_NAME=diverge_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
# Comma-separated CIDRs allowed to supply X-Forwarded-For to the backend.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Optional backend overrides for the on-disk data layout
REPORTS_DIR=./data/reports
DIVERGE_EVAL_RESULTS_DIR=./data/eval_results
SCREENER_RUNS_DIR=./data/screener/runs
SCREENER_TASKS_DIR=./data/screener/tasks
SCREENER_CACHE_DIR=./data/cache/screener
STOCK_HISTORY_DIR=./data/history
FUNDAMENTALS_DIR=./data/fundamentals

# Screener prewarm scheduler. When enabled, the backend enqueues cache-only
# screener runs after each enabled market closes for the default screen and
# every saved user preset, so the next workspace load has a recent result.
SCREENER_PREWARM_ENABLED=true
SCREENER_PREWARM_POLL_SECONDS=300

# Optional market data credentials for scheduled sync jobs
SIMFIN_API_KEY=

# Production task queue
# local -> development in-process task threads
# redis -> production API/worker split using REDIS_URL and multi-layer scheduling
TASK_BACKEND=local
# Deprecated: kept only as a fallback for TASK_GLOBAL_RUNNING_LIMIT.
TASK_QUEUE_LIMIT=2
TASK_GLOBAL_RUNNING_LIMIT=2
TASK_USER_RUNNING_LIMIT=1
TASK_GLOBAL_PENDING_LIMIT=100
TASK_USER_PENDING_LIMIT_ADMIN=10
TASK_USER_PENDING_LIMIT_OPERATOR=5
TASK_USER_PENDING_LIMIT_VIEWER=2
TASK_STORE_TERMINAL_TTL_SECONDS=604800
REDIS_URL=redis://redis:6379/0
# For web/start.sh local Redis testing, use REDIS_URL=redis://127.0.0.1:6379/0.
# Set START_REDIS_DOCKER=true to let web/start.sh start a named Redis container.
START_REDIS_DOCKER=false
REDIS_CONTAINER_NAME=diverge-redis
REDIS_PORT=6379

# Object storage
# local -> development filesystem
# tencent_cos -> production Tencent Cloud COS
# s3_compatible is reserved for a future overseas R2/S3 adapter
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PREFIX=diverge/prod

# Keep false in production so data-source admin policies fail closed if
# database-backed governance is unavailable.
DATA_SOURCE_USAGE_ALLOW_LOCAL_FALLBACK=false
# Optional: force production-style fail-closed governance outside APP_ENV=production.
DATA_SOURCE_GOVERNANCE_STRICT=false

# Production backups
BACKUP_INTERVAL_SECONDS=86400

# Backend-only manifest path used by web-triggered CN screener runs
SCREEN_CN_MANIFEST_PATH=

# Backend-only manifest path used by web-triggered US screener runs
SCREEN_US_MANIFEST_PATH=

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
XIAOHUMINI_API_KEY=
SUB2API_API_KEY=
MASSIVE_API_KEY=
MASSIVE_BASE_URL=http://35.209.101.63/api/v1
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Market data
TUSHARE_TOKEN=
