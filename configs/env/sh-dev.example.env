# Copy this file to configs/env/sh-dev.env and fill the placeholders.
# This profile assumes the SH host contains development support services only.

# SSH target used by scripts/dev-support-tunnel.sh and scripts/dev-sync-data.sh.
# Prefer an SSH config alias such as "sh-dev" so keys, ports, and ProxyJump
# stay in ~/.ssh/config instead of this file.
SH_DEV_SSH_TARGET=ubuntu@sh-dev.example.com

# Local tunnels. Keep these bound to loopback; do not expose database or Redis
# ports on your office network.
DEV_TUNNEL_BIND_ADDRESS=127.0.0.1
DEV_TUNNEL_POSTGRES_LOCAL_PORT=15432
DEV_TUNNEL_POSTGRES_REMOTE_HOST=127.0.0.1
DEV_TUNNEL_POSTGRES_REMOTE_PORT=5432
DEV_TUNNEL_REDIS_LOCAL_PORT=16379
DEV_TUNNEL_REDIS_REMOTE_HOST=127.0.0.1
DEV_TUNNEL_REDIS_REMOTE_PORT=6379

# Local Workbench entrypoints.
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# SH development Postgres through the local tunnel.
AUTH_ENABLED=true
AUTH_MODE=required
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:15432/diverge_dev
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
SESSION_COOKIE_SECURE=false

# SH development Redis through the local tunnel.
# Use a non-production Redis DB and a per-developer prefix so local workers do
# not compete for each other's tasks.
TASK_BACKEND=redis
REDIS_URL=redis://127.0.0.1:16379/1
TASK_STORE_PREFIX=diverge-sh-dev-${USER:-local}
START_REDIS_DOCKER=false

# Keep local execution light. web/start.sh will start a local worker when
# TASK_BACKEND=redis.
TASK_GLOBAL_RUNNING_LIMIT=1
TASK_USER_RUNNING_LIMIT=1
TASK_GLOBAL_PENDING_LIMIT=20
TASK_USER_PENDING_LIMIT_ADMIN=5
TASK_USER_PENDING_LIMIT_OPERATOR=3
TASK_USER_PENDING_LIMIT_VIEWER=1

# Files stay local during development. Use scripts/dev-sync-data.sh when you
# want to pull or push the SH development DATA_DIR snapshot.
STORAGE_BACKEND=local
DATA_DIR=./data
DEV_SYNC_REMOTE_DATA_DIR=/opt/diverge/data-dev
DEV_SYNC_DELETE=false
DEV_SYNC_DRY_RUN=false

# Log handling.
TAIL_LOGS=true
BACKEND_LOG_LEVEL=info
